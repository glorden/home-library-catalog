# Переменные окружения проекта.
# Список пополняется по мере реализации шагов плана:
#   - продовые секреты для деплоя — шаг 8

DEBUG=false
# Под Docker (docker-compose.yml/.override.yml) это значение ни на что не
# влияет — там DEBUG захардкожен (false в проде, true в dev-оверлее), см.
# DEPLOY.md. Играет роль только при локальном запуске без Docker (venv).

# В docker-compose.yml для сервиса app это значение переопределяется на db:5432.
# Локально без Docker (venv) — укажите адрес своего Postgres.
DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library

# Куда сохраняются фото (только обложка хранится долговременно — см. ARCHITECTURE.md).
PHOTO_STORAGE_ROOT=data/photos

# Ключ Fernet для шифрования API-ключей AI-провайдеров в БД (provider_credentials).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Ключ подписи session cookie (itsdangerous, HMAC) — шаг 5.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# true/false — временно закрыть публичную витрину целиком (шаг 5).
SHOWCASE_PUBLIC=true

# Дневной лимит вызовов AI-распознавания — защита от бага/цикла, жгущего
# платный ключ (шаг 5). В коде есть дефолт (30) на случай, если переменная
# не задана вовсе, но под Docker Compose само значение из .env применяется
# только если явно прокинуто в docker-compose.yml (см. environment: сервиса
# app) — иначе .env для контейнера не значит ничего.
AI_EXTRACTION_DAILY_LIMIT=30
